# ─────────────────────────────────────────────
#  Sri Charan Constructions – Environment Config
# ─────────────────────────────────────────────

# Supabase (get these from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Server
PORT=3000
NODE_ENV=development

# Auth (simple PIN for supervisors — change this!)
SUPERVISOR_PIN=1234
JWT_SECRET=change-this-to-a-long-random-secret-string
