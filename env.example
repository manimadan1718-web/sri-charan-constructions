# ─────────────────────────────────────────────
#  Sri Charan Constructions – Environment Config
#  Copy this file to .env and fill it in. NEVER commit .env.
# ─────────────────────────────────────────────

# Supabase (Project Settings → API). The server uses ONLY the secret service_role key.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-secret-key-here

# Server
PORT=3000
NODE_ENV=development            # set to "production" on the live host

# Login tokens — must be a long random value (64+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-secret-string

# First Admin PIN, used ONLY by "npm run setup-db". Choose a strong one, then change it in the app.
SUPERVISOR_PIN=

# ── Optional ──────────────────────────────────
# ALLOWED_ORIGIN=https://app.example.com   # only if the website is ever hosted on a DIFFERENT address than the API
# REPORT_TZ=Asia/Kolkata                   # time zone printed on reports
# REPORT_MAX_PHOTOS=500                    # most photos in one Excel / PDF report
# REPORT_MAX_ROWS=2000                     # most records in one Records report

# ── Contact details shown in the app footer and the privacy policy (leave empty to show nothing) ──
# SUPPORT_EMAIL=
# SUPPORT_PHONE=

# ── Android app (Google Play) — set these AFTER the app is signed in Play Console ──
# ANDROID_PACKAGE_NAME=com.sricharanconstructions.sitelog
# ANDROID_SHA256_CERT_FINGERPRINTS=      # the SHA-256 fingerprint(s) from Play Console → Setup → App signing, comma-separated

# ── Optional: how many requests one address may make in 15 minutes (the default of 300 suits normal use) ──
# API_RATE_LIMIT=300
