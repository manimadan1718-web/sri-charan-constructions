# ─────────────────────────────────────────────
#  Sri Charan Constructions – Environment Config
# ─────────────────────────────────────────────

# Supabase (get these from https://supabase.com → Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Server
PORT=3000
NODE_ENV=development

# Auth
# Each user now logs in with their own PIN (stored in the `users` table,
# created via `npm run setup-db`). SUPERVISOR_PIN below is no longer used
# for login — it's kept only as the PIN for the seed admin account created
# by setup-db, so change it before running setup-db for the first time.
SUPERVISOR_PIN=1234
JWT_SECRET=change-this-to-a-long-random-secret-string
